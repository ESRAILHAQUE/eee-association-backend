// EEE Association - Prisma Schema
// Users: slim (name, registration, role, isVerified, isBlock, isDeleted + login)
// Details: UserProfile (fetch by registration; full access only when verified)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Enums ============
enum GraduationStatus {
  studying
  graduated
  dropped
}

enum AccountType {
  student
  alumni
  teacher
}

enum PaymentStatus {
  paid
  partial
  unpaid
}

enum ResultStatus {
  published
  withheld
}

enum AcademicStanding {
  good
  probation
  warning
}

enum FeeComplianceStatus {
  clear
  pending
}

enum CurrentRole {
  student
  cr
  moderator
  admin
  super_admin
}

// ============ User (slim – only auth + role + flags) ============
model User {
  id                 String   @id @default(cuid())
  fullName           String
  registrationNumber String   @unique
  institutionalEmail String   @unique
  passwordHash       String
  currentRole       CurrentRole @default(student)
  isVerified        Boolean  @default(false)  // admin approved → full access
  isBlock           Boolean  @default(false)
  isDeleted         Boolean  @default(false)
  lastLoginAt       DateTime?
  failedLoginAttempts Int     @default(0)
  accountLocked     Boolean  @default(false)
  accountCreatedAt  DateTime @default(now())
  lastUpdatedAt     DateTime @updatedAt

  profile           UserProfile?
  loginHistory      LoginHistory[]
  passwordResetHistory PasswordResetHistory[]
  associationFees   AssociationFee[]
  academicSemesters AcademicSemester[]
  roleHistory       RoleHistory[]
  noticesCreated       Notice[]         @relation("NoticesCreated")
  eventsCreated        Event[]          @relation("EventsCreated")
  eventsApproved       Event[]          @relation("EventsApproved")
  eventRsvps           EventRsvp[]      @relation("EventRsvps")
  attendanceQRs        AttendanceQR[]   @relation("AttendanceQRsCreated")
  attendances          Attendance[]     @relation("AttendanceRecords")
  certificatesReceived Certificate[]    @relation("CertificatesReceived")
  certificatesIssued   Certificate[]    @relation("CertificatesIssued")
  notifications        Notification[]   @relation("NotificationsReceived")
  notificationsSent    Notification[]   @relation("NotificationsSent")
  forumPosts           ForumPost[]      @relation("ForumPosts")
  forumComments        ForumComment[]   @relation("ForumComments")
  forumVotes           ForumVote[]      @relation("ForumVotes")
  feedbacks            Feedback[]       @relation("FeedbackSubmitted")
  leaveRequests        LeaveRequest[]   @relation("LeaveRequests")
  leaveReviews         LeaveRequest[]   @relation("LeaveReviews")
  resources            Resource[]       @relation("ResourcesUploaded")
  clubMemberships      ClubMember[]     @relation("ClubMemberships")
  projects             Project[]        @relation("Projects")
  mentorProfile        MentorProfile?   @relation("MentorProfile")
  menteeSessions       MentorSession[]  @relation("MenteeSessions")
  documentsUploaded    Document[]       @relation("DocumentsUploaded")
  controlledBatch    Batch?           @relation("BatchCR")

  @@map("users")
}

// ============ Batch Management ============
model Batch {
  id        String   @id @default(cuid())
  name      String   @unique
  crId      String?  @unique
  cr        User?    @relation("BatchCR", fields: [crId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("batches")
}

// ============ User profile (details – access only when isVerified) ============
model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationNumber   String   @unique  // for fetch by reg no
  rollNumber           String?
  batch                String?
  session              String?
  department           String?
  program              String?
  enrollmentYear       Int?
  graduationStatus     GraduationStatus? @default(studying)
  accountType          AccountType       @default(student)
  personalEmail        String?
  phoneNumber          String?
  address              String?
  totalCreditsCompleted Int?    @default(0)
  cgpa                 Float?
  academicStanding     AcademicStanding?
  totalPayable         Decimal? @db.Decimal(12, 2)
  totalPaid            Decimal? @db.Decimal(12, 2)
  totalDue             Decimal? @db.Decimal(12, 2)
  feeComplianceStatus  FeeComplianceStatus?
  approvalStatus       String?
  accessLevel          String?
  lastReviewedByAdmin  DateTime?
  dataConsent          Boolean  @default(false)
  archiveStatus        String?
  isActive             Boolean  @default(true)
  isAlumni             Boolean  @default(false)
  roleHistoryJson      Json?
  transcriptMetadata   Json?
  backlogHistory       Json?
  associationEngagement Json?
  communicationFeedback Json?
  analyticsTracking    Json?
  complianceDiscipline Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([registrationNumber])
  @@map("user_profiles")
}

// ============ Authentication & Security ============
model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt  DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@map("login_history")
}

model PasswordResetHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resetAt    DateTime @default(now())
  tokenUsed  String?

  @@index([userId])
  @@map("password_reset_history")
}

// ============ Association Finance (semester-wise) ============
model AssociationFee {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterNumber       Int
  feeAmount            Decimal       @db.Decimal(12, 2)
  paidAmount           Decimal       @db.Decimal(12, 2) @default(0)
  dueAmount            Decimal       @db.Decimal(12, 2)
  paymentStatus        PaymentStatus @default(unpaid)
  paymentMethod        String?
  transactionReference String?
  paymentDate          DateTime?

  @@unique([userId, semesterNumber])
  @@index([userId])
  @@map("association_fees")
}

// ============ Academic Profile (4 years → 8 semesters) ============
model AcademicSemester {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  year           Int
  semesterNumber Int
  semesterGPA    Float?
  resultStatus   ResultStatus?

  subjects       AcademicSubject[]

  @@unique([userId, year, semesterNumber])
  @@index([userId])
  @@map("academic_semesters")
}

model AcademicSubject {
  id             String           @id @default(cuid())
  semesterId     String
  semester       AcademicSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subjectCode    String
  subjectTitle   String
  credit         Float
  theoryMarks    Float?
  practicalMarks Float?
  totalMarks     Float?
  grade          String?
  gradePoint     Float?

  @@index([semesterId])
  @@map("academic_subjects")
}

// ============ Notices ============
enum NoticeTarget {
  all
  batch_specific
}

model Notice {
  id          String       @id @default(cuid())
  title       String
  content     String
  targetType  NoticeTarget @default(all)
  batch       String?      // set when targetType = batch_specific
  isPinned    Boolean      @default(false)
  isUrgent    Boolean      @default(false)
  createdById String
  createdBy   User         @relation("NoticesCreated", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([batch])
  @@index([createdById])
  @@map("notices")
}

// ============ Events ============
enum EventStatus {
  draft       // proposed by CR/moderator, pending approval
  published   // admin approved / admin created
  cancelled
  completed
}

enum EventType {
  workshop
  seminar
  competition
  cultural
  meeting
  other
}

model Event {
  id           String      @id @default(cuid())
  title        String
  description  String
  eventType    EventType   @default(other)
  status       EventStatus @default(draft)
  venue        String
  startAt      DateTime
  endAt        DateTime
  targetBatch  String?     // null = open to all students
  maxCapacity  Int?
  createdById  String
  createdBy    User        @relation("EventsCreated", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?       @relation("EventsApproved", fields: [approvedById], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  rsvps        EventRsvp[]
  attendanceQR AttendanceQR?
  attendances  Attendance[]
  certificates Certificate[]

  @@index([status])
  @@index([startAt])
  @@index([targetBatch])
  @@index([createdById])
  @@map("events")
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("EventRsvps", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

// ============ Attendance ============
model AttendanceQR {
  id          String   @id @default(cuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token       String   @unique @default(cuid())
  expiresAt   DateTime
  createdById String
  createdBy   User     @relation("AttendanceQRsCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("attendance_qrs")
}

model Attendance {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("AttendanceRecords", fields: [userId], references: [id], onDelete: Cascade)
  scannedAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("attendances")
}

// ============ Certificates ============
model Certificate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("CertificatesReceived", fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  issuedById String
  issuedBy   User     @relation("CertificatesIssued", fields: [issuedById], references: [id])
  issuedAt   DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("certificates")
}

// ============ Notifications ============
enum NotificationStatus {
  unread
  read
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?              @relation("NotificationsSent", fields: [senderId], references: [id], onDelete: SetNull)
  title     String
  message   String
  status    NotificationStatus @default(unread)
  createdAt DateTime           @default(now())

  @@index([userId, status])
  @@index([senderId])
  @@map("notifications")
}

// ============ Forum ============
enum ForumPostStatus {
  active
  flagged
  removed
}

model ForumCategory {
  id    String      @id @default(cuid())
  name  String      @unique
  posts ForumPost[]

  @@map("forum_categories")
}

model ForumPost {
  id         String          @id @default(cuid())
  title      String
  content    String
  categoryId String
  category   ForumCategory   @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User            @relation("ForumPosts", fields: [authorId], references: [id])
  status     ForumPostStatus @default(active)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  comments   ForumComment[]
  votes      ForumVote[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@map("forum_posts")
}

model ForumComment {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("ForumComments", fields: [authorId], references: [id])
  content   String
  createdAt DateTime  @default(now())

  @@index([postId])
  @@map("forum_comments")
}

model ForumVote {
  id     String    @id @default(cuid())
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("ForumVotes", fields: [userId], references: [id])
  vote   Int       // 1 = upvote, -1 = downvote

  @@unique([postId, userId])
  @@map("forum_votes")
}

// ============ Feedback & Complaints ============
enum FeedbackStatus {
  open
  in_progress
  resolved
  dismissed
}

model Feedback {
  id            String         @id @default(cuid())
  submittedById String
  submittedBy   User           @relation("FeedbackSubmitted", fields: [submittedById], references: [id])
  isAnonymous   Boolean        @default(false)
  title         String
  content       String
  batch         String?
  status        FeedbackStatus @default(open)
  resolution    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([batch])
  @@map("feedbacks")
}

// ============ Leave Requests ============
enum LeaveStatus {
  pending
  approved
  rejected
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("LeaveRequests", fields: [userId], references: [id])
  title        String
  reason       String
  leaveDate    DateTime
  returnDate   DateTime
  status       LeaveStatus @default(pending)
  reviewedById String?
  reviewedBy   User?       @relation("LeaveReviews", fields: [reviewedById], references: [id])
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

// ============ Academic Resources ============
enum ResourceStatus {
  pending
  approved
  rejected
}

model Resource {
  id           String         @id @default(cuid())
  title        String
  description  String?
  subject      String
  semester     Int?
  fileUrl      String
  fileType     String
  uploadedById String
  uploadedBy   User           @relation("ResourcesUploaded", fields: [uploadedById], references: [id])
  status       ResourceStatus @default(pending)
  downloads    Int            @default(0)
  batch        String?
  createdAt    DateTime       @default(now())

  @@index([subject])
  @@index([status])
  @@index([uploadedById])
  @@map("resources")
}

// ============ Clubs ============
model Club {
  id          String       @id @default(cuid())
  name        String       @unique
  description String
  logoUrl     String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  members     ClubMember[]

  @@map("clubs")
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("ClubMemberships", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@map("club_members")
}

// ============ Projects ============
enum ProjectCategory {
  iot
  matlab
  power
  embedded
  software
  research
  other
}

model Project {
  id        String          @id @default(cuid())
  title     String
  abstract  String
  category  ProjectCategory @default(other)
  batch     String?
  githubUrl String?
  docUrl    String?
  userId    String
  user      User            @relation("Projects", fields: [userId], references: [id])
  likes     Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([batch])
  @@map("projects")
}

// ============ Mentorship ============
model MentorProfile {
  id        String          @id @default(cuid())
  userId    String          @unique
  user      User            @relation("MentorProfile", fields: [userId], references: [id])
  expertise String[]
  bio       String
  isActive  Boolean         @default(true)

  sessions  MentorSession[]

  @@map("mentor_profiles")
}

model MentorSession {
  id          String        @id @default(cuid())
  mentorId    String
  mentor      MentorProfile @relation(fields: [mentorId], references: [id])
  menteeId    String
  mentee      User          @relation("MenteeSessions", fields: [menteeId], references: [id])
  topic       String
  scheduledAt DateTime
  status      String        @default("pending")
  feedback    String?
  createdAt   DateTime      @default(now())

  @@index([mentorId])
  @@index([menteeId])
  @@map("mentor_sessions")
}

// ============ Documents ============
model Document {
  id           String   @id @default(cuid())
  title        String
  description  String?
  fileUrl      String
  fileType     String
  category     String
  accessLevel  String   @default("all")
  uploadedById String
  uploadedBy   User     @relation("DocumentsUploaded", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([uploadedById])
  @@map("documents")
}

// ============ Roles history ============
model RoleHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String
  assignedAt DateTime @default(now())
  assignedBy String?

  @@index([userId])
  @@map("role_history")
}

